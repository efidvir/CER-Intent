+                    smiv2:max-access "read-only";
+                    smiv2:oid "1.3.6.1.2.1.2.2.1.11";
+                    reference
+                      "RFC 2863: The Interfaces Group MIB - ifInUcastPkts";
+                }
+
+                leaf ifInNUcastPkts {
+                    type yang:counter32;
+                    autocli:hide;
+                    autocli:hide-show;
+                    config false;
+                    status deprecated;
+                    description
+                      "The number of packets, delivered by this sub-layer to a
+                       higher (sub-)layer, which were addressed to a multicast or
+                       broadcast address at this sub-layer.
+                       
+                       Discontinuities in the value of this counter can occur at
+                       re-initialization of the management system, and at other
+                       times as indicated by the value of
+                       ifCounterDiscontinuityTime.
+                       
+                       This object is deprecated in favour of ifInMulticastPkts and
+                       ifInBroadcastPkts.
+                       Not supported";
+                    smiv2:max-access "read-only";
+                    smiv2:oid "1.3.6.1.2.1.2.2.1.12";
+                    reference
+                      "RFC 2863: The Interfaces Group MIB - ifInNUcastPkts";
+                }
+
+                leaf ifInDiscards {
+                    type yang:counter32;
+                    autocli:hide;
+                    autocli:hide-show;
+                    config false;
+                    description
+                      "The number of inbound packets which were chosen to be
+                       discarded even though no errors had been detected to prevent
+                       
+                       their being deliverable to a higher-layer protocol.  One
+                       possible reason for discarding such a packet could be to
+                       free up buffer space.
+                       
+                       Discontinuities in the value of this counter can occur at
+                       re-initialization of the management system, and at other
+                       times as indicated by the value of
+                       ifCounterDiscontinuityTime.";
+                    smiv2:max-access "read-only";
+                    smiv2:oid "1.3.6.1.2.1.2.2.1.13";
+                    reference
+                      "RFC 2863: The Interfaces Group MIB - ifInDiscards";
+                }
+
+                leaf ifInErrors {
+                    type yang:counter32;
+                    autocli:hide;
+                    autocli:hide-show;
+                    config false;
+                    description
+                      "For packet-oriented interfaces, the number of inbound
+                       packets that contained errors preventing them from being
+                       deliverable to a higher-layer protocol.  For character-
+                       oriented or fixed-length interfaces, the number of inbound
+                       transmission units that contained errors preventing them
+                       from being deliverable to a higher-layer protocol.
+                       
+                       Discontinuities in the value of this counter can occur at
+                       re-initialization of the management system, and at other
+                       times as indicated by the value of
+                       ifCounterDiscontinuityTime.";
+                    smiv2:max-access "read-only";
+                    smiv2:oid "1.3.6.1.2.1.2.2.1.14";
+                    reference
+                      "RFC 2863: The Interfaces Group MIB - ifInErrors";
+                }
+
+                leaf ifInUnknownProtos {
+                    type yang:counter32;
+                    autocli:hide;
+                    autocli:hide-show;
+                    config false;
+                    description
+                      "For packet-oriented interfaces, the number of packets
+                       received via the interface which were discarded because of
+                       an unknown or unsupported protocol.  For character-oriented
+                       or fixed-length interfaces that support protocol
+                       multiplexing the number of transmission units received via
+                       the interface which were discarded because of an unknown or
+                       unsupported protocol.  For any interface that does not
+                       support protocol multiplexing, this counter will always be
+                       0.
+                       
+                       Discontinuities in the value of this counter can occur at
+                       re-initialization of the management system, and at other
+                       times as indicated by the value of
+                       ifCounterDiscontinuityTime.
+                       Not supported";
+                    smiv2:max-access "read-only";
+                    smiv2:oid "1.3.6.1.2.1.2.2.1.15";
+                    reference
+                      "RFC 2863: The Interfaces Group MIB - ifInUnknownProtos";
+                }
+
+                leaf ifOutOctets {
+                    type yang:counter32;
+                    autocli:hide;
+                    autocli:hide-show;
+                    config false;
+                    description
+                      "The total number of octets transmitted out of the
+                       interface, including framing characters.
+                       
+                       Discontinuities in the value of this counter can occur at
+                       re-initialization of the management system, and at other
+                       times as indicated by the value of
+                       ifCounterDiscontinuityTime.";
+                    smiv2:max-access "read-only";
+                    smiv2:oid "1.3.6.1.2.1.2.2.1.16";
+                    reference
+                      "RFC 2863: The Interfaces Group MIB - ifOutOctets";
+                }
+
+                leaf ifOutUcastPkts {
+                    type yang:counter32;
+                    autocli:hide;
+                    autocli:hide-show;
+                    config false;
+                    description
+                      "The total number of packets that higher-level protocols
+                       requested be transmitted, and which were not addressed to a
+                       multicast or broadcast address at this sub-layer, including
+                       those that were discarded or not sent.
+                       
+                       Discontinuities in the value of this counter can occur at
+                       re-initialization of the management system, and at other
+                       times as indicated by the value of
+                       ifCounterDiscontinuityTime.";
+                    smiv2:max-access "read-only";
+                    smiv2:oid "1.3.6.1.2.1.2.2.1.17";
+                    reference
+                      "RFC 2863: The Interfaces Group MIB - ifOutUcastPkts";
+                }
+
+                leaf ifOutNUcastPkts {
+                    type yang:counter32;
+                    autocli:hide;
+                    autocli:hide-show;
+                    config false;
+                    status deprecated;
+                    description
+                      "The total number of packets that higher-level protocols
+                       requested be transmitted, and which were addressed to a
+                       multicast or broadcast address at this sub-layer, including
+                       those that were discarded or not sent.
+                       
+                       Discontinuities in the value of this counter can occur at
+                       re-initialization of the management system, and at other
+                       times as indicated by the value of
+                       ifCounterDiscontinuityTime.
+                       
+                       This object is deprecated in favour of ifOutMulticastPkts
+                       and ifOutBroadcastPkts.
+                       Not supported";
+                    smiv2:max-access "read-only";
+                    smiv2:oid "1.3.6.1.2.1.2.2.1.18";
+                    reference
+                      "RFC 2863: The Interfaces Group MIB - ifOutNUcastPkts";
+                }
+
+                leaf ifOutDiscards {
+                    type yang:counter32;
+                    autocli:hide;
+                    autocli:hide-show;
+                    config false;
+                    description
+                      "The number of outbound packets which were chosen to be
+                       discarded even though no errors had been detected to prevent
+                       their being transmitted.  One possible reason for discarding
+                       such a packet could be to free up buffer space.
+                       
+                       Discontinuities in the value of this counter can occur at
+                       re-initialization of the management system, and at other
+                       times as indicated by the value of
+                       ifCounterDiscontinuityTime.";
+                    smiv2:max-access "read-only";
+                    smiv2:oid "1.3.6.1.2.1.2.2.1.19";
+                    reference
+                      "RFC 2863: The Interfaces Group MIB - ifOutDiscards";
+                }
+
+                leaf ifOutErrors {
+                    type yang:counter32;
+                    autocli:hide;
+                    autocli:hide-show;
+                    config false;
+                    description
+                      "For packet-oriented interfaces, the number of outbound
+                       packets that could not be transmitted because of errors.
+                       For character-oriented or fixed-length interfaces, the
+                       number of outbound transmission units that could not be
+                       transmitted because of errors.
+                       
+                       Discontinuities in the value of this counter can occur at
+                       re-initialization of the management system, and at other
+                       times as indicated by the value of
+                       ifCounterDiscontinuityTime.";
+                    smiv2:max-access "read-only";
+                    smiv2:oid "1.3.6.1.2.1.2.2.1.20";
+                    reference
+                      "RFC 2863: The Interfaces Group MIB - ifOutErrors";
+                }
+
+                leaf ifOutQLen {
+                    type yang:gauge32;
+                    autocli:hide;
+                    autocli:hide-show;
+                    config false;
+                    status deprecated;
+                    description
+                      "The length of the output packet queue (in packets).
+                       Not supported";
+                    smiv2:max-access "read-only";
+                    smiv2:oid "1.3.6.1.2.1.2.2.1.21";
+                    reference
+                      "RFC 2863: The Interfaces Group MIB - ifOutQLen";
+                }
+
+                leaf ifSpecific {
+                    type yang:object-identifier-128;
+                    autocli:hide;
+                    autocli:hide-show;
+                    config false;
+                    status deprecated;
+                    description
+                      "A reference to MIB definitions specific to the particular
+                       media being used to realize the interface.  It is
+                       
+                       recommended that this value point to an instance of a MIB
+                       object in the media-specific MIB, i.e., that this object
+                       have the semantics associated with the InstancePointer
+                       textual convention defined in RFC 2579.  In fact, it is
+                       recommended that the media-specific MIB specify what value
+                       ifSpecific should/can take for values of ifType.  If no MIB
+                       definitions specific to the particular media are available,
+                       the value should be set to the OBJECT IDENTIFIER { 0 0 }.
+                       Not supported";
+                    smiv2:max-access "read-only";
+                    smiv2:oid "1.3.6.1.2.1.2.2.1.22";
+                    reference
+                      "RFC 2863: The Interfaces Group MIB - ifSpecific";
+                }
+
+                container copper-specific-config {
+                    uses copper-interface-config;
+                    description
+                      "Configurations that are relevant only when the port is of type RJ-45";
+                }
+
+                leaf physical-connector-type {
+                    type physical-connector-type-enumeration;
+                    config false;
+                    description
+                      "The type of the physical connector, For example: RJ-45";
+                }
+
+                leaf port-speed {
+                    type ethernet-speed;
+                    config false;
+                    description
+                      "Max port speed, relevant for Ethernet ports only";
+                }
+
+                leaf actual-duplex-mode {
+                    type duplex-mode;
+                    config false;
+                    description
+                      "When auto-negotiate is set to 'true', and the port has
+                       completed auto-negotiation with the remote peer, this value
+                       shows the duplex mode that has been negotiated.
+                       This parameter is relevant only for ETH ports";
+                }
+
+                leaf actual-port-speed {
+                    type ethernet-speed;
+                    config false;
+                    description
+                      "This value shows the actual speed of the port. It is determined either by 
+                       auto-negotiation or the port speed configuration. 
+                       This parameter is relevant only for ETH ports";
+                }
+
+                leaf interface-type {
+                    type if-type;
+                    config false;
+                    mandatory true;
+                    description
+                      "The interface type. e.g., host/eth/rf";
+                }
+
+                leaf time-since-last-clear {
+                    type string;
+                    config false;
+                    description
+                      "This value shows the time since last clear statistics command, presented in format of DDDDD:HH:MM:SS";
+                }
+            }
+
+            description
+              "Top level container for all interfaces";
+        }
+    }
+
+// data definition statements
+    uses interfaces-top;
+
+// augment statements
+    augment "/interfaces/interface" {
+        description
+          "An entry containing additional management information
+            applicable to a particular interface.";
+        smiv2:oid "1.3.6.1.2.1.31.1.1.1";
+
+        leaf name {
+            type union{
+                type rb-tg-types:host-interface-name;
+                type rb-tg-types:embedded-interface-name;
+                type rb-tg-types:rf-interface-name;
+                type rb-tg-types:tunnel-interface-name;
+                type rb-tg-types:bond-interface-name;
+            }
+            description
+              "The interface's name:
+               host or
+               The eth port's name. (format 'eth<number>') or 
+               The name of the RF link. (format: 'rf-<AN>') or
+               The tunnels's name. (format 'tunnel-<TunnelId> or'
+               The bond's name. (format 'bond-<name>'
+              ";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.1";
+            smiv2:display-hint "255a";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifName";
+        }
+
+        leaf ifInMulticastPkts {
+            type yang:counter32;
+            autocli:hide;
+            autocli:hide-show;
+            config false;
+            description
+              "The number of packets, delivered by this sub-layer to a
+                higher (sub-)layer, which were addressed to a multicast
+                address at this sub-layer.  For a MAC layer protocol, this
+                includes both Group and Functional addresses.
+               
+                Discontinuities in the value of this counter can occur at
+                re-initialization of the management system, and at other
+               
+                times as indicated by the value of
+                ifCounterDiscontinuityTime.
+                Not supported";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.2";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifInMulticastPkts";
+        }
+
+        leaf ifInBroadcastPkts {
+            type yang:counter32;
+            autocli:hide;
+            autocli:hide-show;
+            config false;
+            description
+              "The number of packets, delivered by this sub-layer to a
+                higher (sub-)layer, which were addressed to a broadcast
+                address at this sub-layer.
+               
+                Discontinuities in the value of this counter can occur at
+                re-initialization of the management system, and at other
+                times as indicated by the value of
+                ifCounterDiscontinuityTime.
+                Not supported";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.3";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifInBroadcastPkts";
+        }
+
+        leaf ifOutMulticastPkts {
+            type yang:counter32;
+            autocli:hide;
+            autocli:hide-show;
+            config false;
+            description
+              "The total number of packets that higher-level protocols
+                requested be transmitted, and which were addressed to a
+                multicast address at this sub-layer, including those that
+                were discarded or not sent.  For a MAC layer protocol, this
+                includes both Group and Functional addresses.
+               
+                Discontinuities in the value of this counter can occur at
+                re-initialization of the management system, and at other
+                times as indicated by the value of
+                ifCounterDiscontinuityTime.
+                Not supported";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.4";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifOutMulticastPkts";
+        }
+
+        leaf ifOutBroadcastPkts {
+            type yang:counter32;
+            autocli:hide;
+            autocli:hide-show;
+            config false;
+            description
+              "The total number of packets that higher-level protocols
+                requested be transmitted, and which were addressed to a
+                broadcast address at this sub-layer, including those that
+                were discarded or not sent.
+               
+                Discontinuities in the value of this counter can occur at
+                re-initialization of the management system, and at other
+               
+                times as indicated by the value of
+                ifCounterDiscontinuityTime.
+                Not supported";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.5";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifOutBroadcastPkts";
+        }
+
+        leaf in-octets {
+            type yang:counter64;
+            config false;
+            description
+              "The total number of octets received on the port,
+               including framing characters.
+               Discontinuities in the value of this counter can occur
+               at re-initialization of the unit, and after clear statistics command.";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.6";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifHCInOctets";
+        }
+
+        leaf in-pkts {
+            type yang:counter64;
+            config false;
+            description
+              "The total number of packets received on the port,
+               including all unicast, multicast, broadcast and bad packets
+               etc.";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.7";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifHCInUcastPkts";
+        }
+
+        leaf in-discards {
+            type yang:counter64;
+            config false;
+            description
+              "The number of inbound packets that were 
+               discarded even though no errors had been detected.
+               
+               Discontinuities in the value of this counter can occur
+               at re-initialization of the unit, and after clear statistics command.";
+        }
+
+        leaf in-errors {
+            type yang:counter64;
+            config false;
+            description
+              "The number of inbound packets that contained errors. 
+               
+               Discontinuities in the value of this counter can occur
+               at re-initialization of the unit, and after clear statistics command.";
+        }
+
+        leaf in-no-rule-discards {
+            type yang:counter64;
+            config false;
+            description
+              "The number of inbound packets that were
+               discarded for some reason (f.ex. not in any bridge).
+               
+               Discontinuities in the value of this counter can occur
+               at re-initialization of the unit, and after clear statistics command.";
+        }
+
+        leaf ifHCInMulticastPkts {
+            type yang:counter64;
+            autocli:hide;
+            autocli:hide-show;
+            config false;
+            description
+              "The number of packets, delivered by this sub-layer to a
+                higher (sub-)layer, which were addressed to a multicast
+                address at this sub-layer.  For a MAC layer protocol, this
+                includes both Group and Functional addresses.  This object
+                is a 64-bit version of ifInMulticastPkts.
+               
+                Discontinuities in the value of this counter can occur at
+                re-initialization of the management system, and at other
+                times as indicated by the value of
+                ifCounterDiscontinuityTime.
+                Not supported";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.8";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifHCInMulticastPkts";
+        }
+
+        leaf ifHCInBroadcastPkts {
+            type yang:counter64;
+            autocli:hide;
+            autocli:hide-show;
+            config false;
+            description
+              "The number of packets, delivered by this sub-layer to a
+                higher (sub-)layer, which were addressed to a broadcast
+                address at this sub-layer.  This object is a 64-bit version
+                of ifInBroadcastPkts.
+               
+                Discontinuities in the value of this counter can occur at
+                re-initialization of the management system, and at other
+                times as indicated by the value of
+                ifCounterDiscontinuityTime.
+                Not supported";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.9";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifHCInBroadcastPkts";
+        }
+
+        leaf out-octets {
+            type yang:counter64;
+            config false;
+            description
+              "The total number of octets transmitted out of the
+               port, including framing characters.          
+               Discontinuities in the value of this counter can occur
+               at re-initialization of the unit, and after clear statistics command.";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.10";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifHCOutOctets";
+        }
+
+        leaf out-pkts {
+            type yang:counter64;
+            config false;
+            description
+              "The total number of packets transmitted out of the
+               port, including all unicast, multicast, broadcast,
+               and bad packets etc.";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.11";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifHCOutUcastPkts";
+        }
+
+        leaf out-discards {
+            type yang:counter64;
+            config false;
+            description
+              "The number of outbound packets that were chosen to be
+               discarded even though no errors had been detected to
+               prevent their being transmitted.  One possible reason
+               for discarding such a packet could be to free up queue
+               space.
+               
+               Discontinuities in the value of this counter can occur
+               at re-initialization of the unit, and after clear statistics command.";
+        }
+
+        leaf out-errors {
+            type yang:counter64;
+            config false;
+            description
+              "The number of outbound packets that could not be transmitted because of errors.
+               
+               Discontinuities in the value of this counter can occur
+               at re-initialization of the unit, and after clear statistics command.";
+        }
+
+        leaf ifHCOutMulticastPkts {
+            type yang:counter64;
+            autocli:hide;
+            autocli:hide-show;
+            config false;
+            description
+              "The total number of packets that higher-level protocols
+                requested be transmitted, and which were addressed to a
+                multicast address at this sub-layer, including those that
+                were discarded or not sent.  For a MAC layer protocol, this
+                includes both Group and Functional addresses.  This object
+                is a 64-bit version of ifOutMulticastPkts.
+               
+                Discontinuities in the value of this counter can occur at
+                re-initialization of the management system, and at other
+                times as indicated by the value of
+                ifCounterDiscontinuityTime.
+                Not supported";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.12";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifHCOutMulticastPkts";
+        }
+
+        leaf ifHCOutBroadcastPkts {
+            type yang:counter64;
+            autocli:hide;
+            autocli:hide-show;
+            config false;
+            description
+              "The total number of packets that higher-level protocols
+                requested be transmitted, and which were addressed to a
+                broadcast address at this sub-layer, including those that
+                were discarded or not sent.  This object is a 64-bit version
+                of ifOutBroadcastPkts.
+               
+                Discontinuities in the value of this counter can occur at
+                re-initialization of the management system, and at other
+                times as indicated by the value of
+                ifCounterDiscontinuityTime.
+                Not supported";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.13";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifHCOutBroadcastPkts";
+        }
+
+        leaf ifLinkUpDownTrapEnable {
+            type enumeration {
+                enum "enabled" {
+                    value "1";
+                    description
+                      "enable";
+                }
+                enum "disabled" {
+                    value "2";
+                    description
+                      "disable";
+                }
+            }
+            autocli:hide;
+            autocli:hide-show;
+            config false;
+            description
+              "Indicates whether linkUp/linkDown traps should be generated
+                for this interface.
+               
+                By default, this object should have the value enabled(1) for
+                interfaces which do not operate on 'top' of any other
+                interface (as defined in the ifStackTable), and disabled(2)
+                otherwise.
+                Traps are currently not supported and this parameter is always set to disabled(2)";
+            smiv2:max-access "read-write";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.14";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifLinkUpDownTrapEnable";
+        }
+
+        leaf ifHighSpeed {
+            type yang:gauge32;
+            autocli:hide;
+            autocli:hide-show;
+            config false;
+            description
+              "An estimate of the interface's current bandwidth in units
+                of 1,000,000 bits per second.  If this object reports a
+                value of `n' then the speed of the interface is somewhere in
+                the range of `n-500,000' to `n+499,999'.  For interfaces
+                which do not vary in bandwidth or for those where no
+                accurate estimation can be made, this object should contain
+                the nominal bandwidth.  For a sub-layer which has no concept
+                of bandwidth, this object should be zero.";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.15";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifHighSpeed";
+        }
+
+        leaf ifPromiscuousMode {
+            type boolean;
+            autocli:hide;
+            autocli:hide-show;
+            config false;
+            description
+              "This object has a value of false(2) if this interface only
+                accepts packets/frames that are addressed to this station.
+                This object has a value of true(1) when the station accepts
+                all packets/frames transmitted on the media.  The value
+                true(1) is only legal on certain types of media.  If legal,
+                setting this object to a value of true(1) may require the
+                interface to be reset before becoming effective.
+               
+                The value of ifPromiscuousMode does not affect the reception
+                of broadcast and multicast packets/frames by the interface.
+                Currently not supported and this parameter is always set to false(2)";
+            smiv2:max-access "read-write";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.16";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifPromiscuousMode";
+        }
+
+        leaf ifConnectorPresent {
+            type boolean;
+            autocli:hide;
+            autocli:hide-show;
+            config false;
+            description
+              "This object has the value 'true(1)' if the interface
+                sublayer has a physical connector and the value 'false(2)'
+                otherwise.";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.17";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifConnectorPresent";
+        }
+
+        leaf alias {
+            type rb-tg-types:radio-bridge-tg-string {
+                length "0..20";
+            }
+            default "";
+            description
+              "The alias name of interface given by user.";
+            smiv2:defval "";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.18";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifAlias";
+        }
+
+        leaf ifCounterDiscontinuityTime {
+            type yang:timestamp;
+            autocli:hide;
+            autocli:hide-show;
+            config false;
+            description
+              "The value of uptime-hundredths-seconds on the most recent occasion 
+                at which any one or more of this interface's counters suffered a
+                discontinuity.  The relevant counters are the specific
+                instances associated with this interface of any Counter32 or
+               
+                Counter64 object contained in the ifTable or ifXTable. If
+                no such discontinuities have occurred since the last re-
+                initialization of the local management subsystem, then this
+                object contains a zero value.
+                Currently not supported and the return value is always zero";
+            smiv2:max-access "read-only";
+            smiv2:oid "1.3.6.1.2.1.31.1.1.1.19";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifCounterDiscontinuityTime";
+        }
+
+        leaf ptp-tc-support {
+            type boolean;
+            default false;
+            config false;
+            description
+              "This parameter indicates whether the interface supports IEEE 1588 Transparent Clock (TC) functionality.
+                If set to 'true', the interface is capable of operating as a transparent clock, forwarding PTP messages
+                and adjusting the timestamps accordingly. If set to 'false', the interface does not support PTP TC operations.";
+        }
+
+        leaf ptp-tc-enable {
+            type boolean;
+            default false;
+            description
+              "This parameter indicates whether the interface is configured for IEEE 1588 Transparent Clock (TC).
+                If set to 'true', the interface will operate as a transparent clock, forwarding PTP messages
+                and adjusting the timestamps accordingly. If set to 'false', the interface will not perform
+                any PTP-related operations.";
+        }
+    }
+
+// rpc statements
+    rpc clear-all-interfaces-statistics {
+        description
+          "RPC for clearing the traffic statistics for all interfaces";
+    }
+// notification statements
+}
diff --git a/src/device/service/drivers/ceragon/schemas/yang/radio-bridge-tg-inventory.yang b/src/device/service/drivers/ceragon/schemas/yang/radio-bridge-tg-inventory.yang
