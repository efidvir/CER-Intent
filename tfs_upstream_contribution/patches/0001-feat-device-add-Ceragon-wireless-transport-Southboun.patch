+
+    grouping topo-scan-top {
+        container topo-scan {
+            config false;
+            leaf progress-status {
+              type topo-scan-progress-status-type;
+              default not-started;
+              description
+                "This is the overall status of the scan, not per sector.";
+            }
+            list per-sector-results {
+                key sector-index;
+                uses topo-scan-per-sector-result;
+                description
+                  "List of local sectors, their topo scan progress and results";
