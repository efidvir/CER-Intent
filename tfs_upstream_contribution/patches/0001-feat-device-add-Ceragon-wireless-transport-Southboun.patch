+        prefix "rb-tg-types";
+    }
+
+    // meta
+    organization
+      "Siklu";
+
+    contact
+      "Support: <https://siklu.com/contact/>";
+
+    description
+      "This module defines how control the attenuation on spider devices";
+
+    revision 2023-04-20 {
+        description
+          "Change yang version to 1.1";
+        reference
+          "";
+    }
+
+    revision 2022-03-31 {
+        description
+          "Add feature spider-device to the module";
+        reference
+          "";
+    }
+    revision 2022-03-10 {
+        description
+          "Initial version";
+        reference
+          "";
+    }
+
