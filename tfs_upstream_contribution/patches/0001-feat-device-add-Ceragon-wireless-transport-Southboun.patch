+
+    grouping ignition-config-dn-top {
+        container ignition-config {
+            description
+              "The container contains all configuration settings for the radio links ignition procedure.";
+            leaf idle-timer {
+              type uint16 {
+                range "0..3600";
+              }
+              units seconds;
+              default 600;
+              description
+                "The delay between ignition sessions.";
+            }
+            leaf ignition-timer {
+              type uint16 {
+                range "37..3600";
+              }
+              units seconds;
+              default 240;
+              description
+                "The duration of the ignition session.";
+            }
+            leaf retry-count {
+              type uint8 {
+                range "1..32";
+              }
+              default 2;
+              description
+                "Maximum retry count to raise a radio link during one ignition session.";
+            }
+            leaf link-stability-monitor-timer {
+              type uint16 {
+                range "0..3600";
+              }
+              units seconds;
+              default 900;
+              description
+                "The duration when a link shall not fail to become stable.";
+            }
+            leaf link-stability-disconnection-limit {
+              type uint8 {
+                range "1..15";
+              }
+              default 3;
+              description
+                "Maximum disconnection count of link in monitor timer to consider the link is unstable.";
+            }
