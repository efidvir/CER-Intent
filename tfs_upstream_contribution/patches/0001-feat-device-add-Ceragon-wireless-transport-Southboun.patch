@@ -0,0 +1,1282 @@
+  
+  module radio-bridge-tg-interfaces {
+
+    yang-version "1.1";
+
+// namespace
+    namespace "http://siklu.com/yang/tg/interfaces";
+
+    prefix "rb-tg-if";
+
+    import ietf-yang-types {
+        prefix yang;
+    }
+    import radio-bridge-tg-types {
+        prefix rb-tg-types;
+    }
+    import ietf-yang-smiv2 {
+        prefix "smiv2";
+    }
+    import clixon-snmp {
+        prefix "cx-snmp";
+    }
+    import clixon-autocli {
+        prefix autocli;
+    }
+    import SNMPv2-TC {
+        prefix "snmpv2-tc";
+    }
+    import IANAifType-MIB {
+        prefix "ianaiftype-mib";
+    }
+
+// meta
+    organization
+      "Siklu";
+
+    contact
+      "Support: <https://siklu.com/contact/>";
+
+    description
+      "TODO";
+
+    revision 2025-06-25 {
+        description
+          "Add leaves pertaining to IEEE 1588TC operation on the interface";
+        reference
+          "";
+    }
+
+    revision 2025-01-08 {
+        description
+          "Add leaf to indicate time in seconds since clear command";
+        reference
+          "";
+    }
+
+    revision 2023-05-16 {
+        description
+          "Hide if-number container from CLI.";
+        reference
+          "";
+    }
+    revision 2023-04-20 {
+        description
+          "Change yang version to 1.1";
+        reference
+          "";
+    }
+
+    revision 2023-03-16 {
+        description
+          "Support for SNMP ifTable";
+        reference
+          "";
+    }
+
+    revision 2023-02-28 {
+        description
+          "Flatten the interface table";
+        reference
+          "";
+    }
+
+    revision 2022-10-25 {
+        description
+          "Changed bonds active member to oper-status";
+        reference
+          "";
+    }
+
+    revision 2022-10-19 {
+        description
+          "Added bonds list and added counters to tunnels list";
+        reference
+          "";
+    }
+
+    revision 2022-07-21 {
+        description
+          "Adding tunnel interface";
+        reference
+          "";
+    }
+
+    revision 2021-11-18 {
+        description
+          "1.2.0 release";
+        reference
+          "";
+    }
+
+    revision 2021-05-25 {
+        description
+          "Release";
+        reference
+          "";
+    }
+
+    revision 2020-08-05 {
+        description
+          "Initial revision";
+        reference
+          "TBD";
+    }
+
+// extension statements
+// feature statements
+// identity statements
+// typedef statements  
+    typedef physical-connector-type-enumeration {
+        type enumeration {
+            enum RJ-45 {
+                description
+                  "RJ-45";
+            }
+            enum SFP {
+                description
+                  "SFP";
+            }
+            enum 'SFP+' {
+                description
+                  "SFP+";
+            }
+            enum GPON {
+                description
+                  "GPON";
+            }
+        }
+        description
+          "physical connector type";
+    }
+    typedef ethernet-speed {
+        type enumeration {
+            enum 10Mbps {
+                description
+                  "10Mbps";
+            }
+            enum 100Mbps {
+                description
+                  "100Mbps";
+            }
+            enum 1Gbps {
+                description
+                  "1Gbps";
+            }
+            enum 2500Mbps {
+                description
+                  "2.5Gbps";
+            }
+            enum 5Gbps {
+                description
+                  "5Gbps";
+            }
+            enum 10Gbps {
+                description
+                  "10Gbps";
+            }
+        }
+        description
+          "Port speed";
+    }
+
+    typedef duplex-mode {
+        type enumeration {
+            enum full {
+                description
+                  "Full duplex mode";
+            }
+            enum half {
+                description
+                  "Half duplex mode";
+            }
+        }
+        description
+          "Duplex mode of the port";
+    }
+
+    typedef if-type {
+        type enumeration {
+            enum host {
+                description
+                  "host interface";
+            }
+            enum ethernet {
+                description
+                  "ethernet interface";
+            }
+            enum rf {
+                description
+                  "rf interface";
+            }
+            enum bond {
+                description
+                  "bond interface";
+            }
+            enum tunnel {
+                description
+                  "tunnel interface";
+            }
+        }
+        description
+          "interface type";
+    }
+
+// grouping statements
+    grouping copper-interface-config {
+        leaf speed {
+            type ethernet-speed;
+            description
+              "When auto-negotiate is 'true', this optionally sets the
+               port-speed mode that will be advertised to the peer for
+               negotiation. If unspecified, it is expected that the
+               port will select the highest speed available based on
+               negotiation.  When auto-negotiate is set to 'false', sets the
+               link speed to a fixed value. According to IEEE 802.3, for speeds 
+               of 1Gbps and higher, auto-negotiation must be on.";
+        }
+        leaf auto-negotiate {
+            type boolean;
+            default true;
+            description
+              "Set to 'true' to request the port to auto-negotiate
+               transmission parameters with its peer port.  When
+               set to 'false', the transmission parameters are specified
+               manually.";
+            reference
+              "IEEE 802.3-2012 auto-negotiation transmission parameters";
+        }
+        leaf duplex-mode {
+            type duplex-mode;
+            description
+              "When auto-negotiate is 'true', this optionally sets the
+               duplex mode that will be advertised to the peer.  If
+               unspecified, the port should negotiate the duplex mode
+               directly (typically full-duplex).  When auto-negotiate is
+               'false', this sets the duplex mode on the port directly.";
+        }
+        leaf pse-out {
+            type boolean;
+            description
+              "Set to 'true' to enable PSE/PoE-out. This feature should be supported by the hardware for this port";
+        }
+        description
+          "Set of configurations for RJ-45 ports";
+    }
+
+    grouping interfaces-top {
+        description
+          "Top-level grouping for port configuration and state data";
+
+        container if-number {
+            config false;
+
+            leaf ifNumber {
+                type int32;
+                autocli:hide;
+                autocli:hide-show;
+                config false;
+                description
+                  "The number of network interfaces (regardless of their
+                   current state) present on this system.";
+                smiv2:max-access "read-only";
+                smiv2:oid "1.3.6.1.2.1.2.1";
+                reference
+                  "RFC 2863: The Interfaces Group MIB - ifNumber";
+            }
+
+            autocli:hide;
+            autocli:hide-show;
+            description
+              "A container for ifNumber scalar";
+        }
+
+        container interfaces {
+            smiv2:oid "1.3.6.1.2.1.2.2";
+
+            list interface {
+                key "name";
+                description
+                  "The list of all interfaces of the device.";
+                smiv2:oid "1.3.6.1.2.1.2.2.1";
+                cx-snmp:table-key "ifIndex";
+
+                leaf ifIndex {
+                    type rb-tg-types:InterfaceIndex;
