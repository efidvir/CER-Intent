+
+    // grouping statements
+    grouping rf-sync-top {
+        container rf-sync {
+            if-feature "rb-tg-types:sync-mode-ptp or rb-tg-types:sync-mode-rf or rb-tg-types:sync-mode-gps";
+            
+            leaf enabled {
+                type boolean;
+                default true;
+                description
+                  "The node can transmit or receive rf-sync data
+                   and use or fallback to rf-sync mode if supported";
+            }
+            leaf allow-free-running {
+                if-feature rb-tg-types:sync-mode-rf;
+                type boolean;
+                default false;
+                description
+                  "The node is allowed to use and ignite links 
+                   even after receiving free-running sync from a remote peer.";
+            }
+            list ignored-neighbors {
+                if-feature rb-tg-types:sync-mode-rf;
+                key assigned-name;
+                leaf assigned-name {
+                    type rb-tg-types:node-assigned-name;
+                    description
+                      "The assigned name of the ignored neighbor node";
+                }
+                description
+                  "A list of neighbors that their clock source should be ignored";
+            }
+            uses rf-sync-state-grouping;
+            description
+              "rf-sync configuration and state data";
+        }
+        description
+          "rf-sync container grouping";
+    }
+    grouping node-dn-top {
+        container node-config {
+            description
+              "The container includes all the configuration that are related to the entire TG unit.";
+            container default-radio-profile {
+                uses rb-tg-radio:radio-frequency;
+                uses rb-tg-radio:radio-polarity;
+                uses rb-tg-radio:radio-golay-index;
+                description
+                  "Defaults for radio configuration (Rx-Tx). Applies to sectors when they have no specified radio configuration.";
