+                    smiv2:oid "1.3.6.1.2.1.2.2.1.4";
+                    reference
+                      "RFC 2863: The Interfaces Group MIB - ifMtu";
+                }
+
+                leaf ifSpeed {
+                    type yang:gauge32;
+                    autocli:hide;
+                    autocli:hide-show;
+                    config false;
