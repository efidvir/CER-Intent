@@ -0,0 +1,234 @@
+module radio-bridge-tg-logging {
+
+    yang-version "1.1";
+
+    // namespace
+    namespace "http://siklu.com/yang/tg/logging";
+
+    prefix "rb-tg-log";
+
+    import radio-bridge-tg-types {
+        prefix rb-tg-types;
+    }
+    
+    // meta
+    organization
+      "Siklu";
+
+    contact
+      "Support: <https://siklu.com/contact/>";
+
+    description
+      "TODO";
+
+    revision 2025-02-06 {
+        description
+          "Added rpc add-debug-log to receiving test information for debug";
+        reference
+          "";
+    }
+
+    revision 2024-02-16 {
+        description
+          "Added rpc set-log-config to configuring module loggin severity";
+        reference
+          "";
+    }
+
+    revision 2023-10-11 {
+        description
+          "Change name the rpc for printing internal entity to debug-dump-class-info-into-log.
+           Change name of the parameter to class-name";
+        reference
+          "";
+    }
+
+    revision 2023-10-10 {
+        description
+          "Add rpc for printing internal entity (e.g, class) db for debug";
+        reference
+          "";
+    }
+      
+    revision 2023-07-06 {
+        description
+          "increase log-module-type string length to 256";
+        reference
+          "";
+    }
+    
+    revision 2023-04-20 {
+        description
+          "Change yang version to 1.1";
+        reference
+          "";
+    }
+
+    revision 2021-12-29 {
+        description
+          "Initial revision";
+        reference
+          "TBD";
+    }
+
+    // extension statements
+    // feature statements
+    // identity statements
+    // typedef statements  
+    typedef log-severity-type {
+        type enumeration {
+            enum None {
+                description
+                  "Logging is disabled";
+            }
+            enum Error {
+                description
+                  "Error level severity";
+            }
+            enum Warning {
+                description
+                  "Warning level severity";
+            }
+            enum Info {
+                description
+                  "Information level severity";
+            }
+            enum Verbose {
+                description
+                  "Verbose level severity";
+            }
+        }
+        description
+          "All possible severity levels for logging";
+    }
+
+    typedef log-module-type {
+        type union {
+            type enumeration {
+                enum radio-firmware {
+                    description
+                      "Logs generated by radio firmware";
+                }
+            }
+            type string {
+                length 1..256;
+            }
+        }
+        description
+          "All modules allowed for log configuration";
+    }
+
+    typedef tech-file-creation-state-type {
+        type enumeration {
+            enum idle {
+                description
+                  "Ready to create a technician file";
+            }
+            enum in-progress {
+                description
+                  "Currently creating a technician file";
+            }
+            enum failure {
+                description
+                  "An error was encountered in the last technician file creation attempt. idle state.";
+            }
+        }
+        description
+          "Possible states in the technician file creation process";
+    }
+
+    // grouping statements
+    grouping logging-config-top {
+        list log {
+            leaf "module" {
+                type log-module-type;
+                description
+                  "Log module type";
+            }
+            key "module";
+            leaf severity {
+                type log-severity-type;
+                description
+                  "Module log severity";
+            }
+            description
+              "List of all configurable log modules";
+        }
+        description
+          "Grouping for logs configuration";
+    }
+
+    grouping logging-state-top {
+        leaf technician-file-creation {
+            type tech-file-creation-state-type;
+            default idle;
+            description
+              "The technician file creation process state";
+        }
+        description
+          "Grouping for logs state";
+    }
+// data definition statements
+// augment statements
+
+// rpc statements
+rpc debug-dump-class-info-into-log {
+    description
+      "RPC for printing a specific class internal db information into clixon log. Used for debug.
+      Example: debug dump-class-info-into-log class-name ClockInfoProtocol";
+    input{
+        leaf class-name {
+            type rb-tg-types:radio-bridge-tg-string {
+                length "1..128";
+            }
+            mandatory true;
+            description
+              "Name of class to print its internal db info (e.g, ClockInfoProtocol)";
+        }
+    }
+}
+
+rpc debug-set-log-config {
+    description
+      "RPC for configuring log module severity. Used for temporal configuring.
+      Example: debug set-log-config module-name radio-firmware severity Verbose";
+    input{
+        leaf module-name {
+            type log-module-type;
+            mandatory true;
+            description
+              "Name of module for configuring (e.g. radio-firmware) ";
+        }
+        leaf severity  {
+            type log-severity-type;
+            mandatory true;
+            description
+              "Module log severity (e.g. None, Verbose, Info)";
+        }
+    }
+}
+
+rpc add-debug-log {
+    description
+      "This RPC is dedicated for printing information for debug";
+    input{
+        leaf title {
+            type string {
+                length "1..256";
+            }
+            mandatory true;
+            description
+              "Title of the test";
+        }
+        leaf content {
+            type string {
+                length "1..1024";
+            }
+            description
+              "Content or description of the test";
+        }
+    }
+}
+
+// notification statements
+}
diff --git a/src/device/service/drivers/ceragon/schemas/yang/radio-bridge-tg-ping.yang b/src/device/service/drivers/ceragon/schemas/yang/radio-bridge-tg-ping.yang
new file mode 100644
index 000000000..ac6b3e7be
--- /dev/null
+++ b/src/device/service/drivers/ceragon/schemas/yang/radio-bridge-tg-ping.yang
@@ -0,0 +1,205 @@
+module radio-bridge-tg-ping {
+
+    yang-version "1.1";
+
+    // namespace
+    namespace "http://siklu.com/yang/tg/ping";
+
+    prefix "rb-tg-ping";
+
+    import ietf-inet-types {
+        prefix inet;
+    }
+
+    // meta
+    organization
+      "Siklu";
+
+    contact
+      "Support: <https://siklu.com/contact/>";
+
+    description
+      "This module defines how the ping functionality will work";
+
+    revision 2023-04-20 {
+        description
+          "Change yang version to 1.1";
+        reference
+          "";
+    }
+
+    revision 2021-05-25 {
+        description
+          "Release";
+        reference
+          "";
+    }
+
+    revision 2020-02-11 {
+        description
+          "Initial revision";
+        reference
+          "TBD";
+    }
+
+    // extension statements
+    // feature statements
+    // identity statements
+    // typedef statements  
+    typedef ping_id {
+        type uint16;
+        description
+          "ID of the ping session";
+    }
+
+    typedef latency {
+        type decimal64 {
+            fraction-digits 3;
+        }
+        description
+          "Round trip time (RTT) of a successful ping, in Milliseconds";
+    }
+
+    typedef latency_or_timeout {
+        type union {
+            type latency;
+            type enumeration {
+                enum TIMEOUT {
+                    description
+                      "No ping reply packet has been received for the timeout period";
+                }
+            }
+        }
+        description
+          "Ping latency or timeout";
+    }
+    // grouping statements
+    grouping ping-statistics-grouping {
+        container ping-statistics {
+            leaf minimum-rtt {
+                type latency;
+                description
+                  "Minimum Round Trip Time (RTT) in this ping session";
+            }
+
+            leaf maximum-rtt {
+                type latency;
+                description
+                  "Maximum Round Trip Time (RTT) in this ping session";
+            }
+
+            leaf average-rtt {
+                type latency;
+                description
+                  "Average Round Trip Time (RTT) in this ping session";
+            }
+
+            leaf total-ping-sent {
+                type uint32;
+                description
+                  "The total number of pings sent in this ping session";
+            }
+
+            leaf total-ping-reply-received {
+                type uint32;
+                description
+                  "The total number of pings replies received in this ping session";
+            }
+            description
+              "Ping session statistics";
+        }
+        description
+          "Top level grouping for ping session statistics";
+    }
+    // data definition statements
+    // augment statements
+    // rpc statements
+    rpc start-ping {
+        description
+          "Request to start sending ping messages";
+        input{
+            leaf host {
+                type inet:ip-address;
+                mandatory true;
+                description
+                  "Destination host";
+            }
+            leaf count {
+                type uint32 {
+                    range 1..1000;
+                }
+                default 5;
+                description
+                  "The number of ping messages to send";
+            }
+            leaf size {
+                type uint32;
+                default 56;
+                description
+                  "Specifies the number of data bytes to be sent; The default is 56, "
+                + "which translates into 64 ICMP data bytes when combined with the 8 "
+                + "bytes of ICMP header data.";
+            }
+        }
+        output{
+            leaf id {
+                type ping_id;
+                mandatory true;
+                description
+                  "ID of the ping session";
+            }
+        }
+    }
+
+    rpc get-replies {
+        description
+          "Get information about a ping session"
+        + "This API is clear on read";
+        input {
+            leaf id {
+                type ping_id;
+                mandatory true;
+                description
+                  "ID of the ping session (return value of start-ping)";
+            }
+        }
+        output{
+            list replies {
+                leaf latency {
+                    type latency_or_timeout;
+                    mandatory true;
+                    description
+                      "Latency of the reply, or timeout";
+                }
+                leaf sequence {
+                    type uint32;
+                    mandatory true;
+                    description
+                      "Sequence number of the reply";
+                }
+                leaf response_ip {
+                    type inet:ip-address;
+                    description
+                      "Source IP address of the ping response";
+                }
+                description
+                  "List of ping replies";
+            }
+            uses ping-statistics-grouping;
+        }
+    }
+
+    rpc cancel-ping {
+        description
+          "Cancel an ongoing ping";
+        input {
+            leaf id {
+                type ping_id;
+                mandatory true;
+                description
+                  "ID of the ping session (return value of start-ping)";
+            }
+        }
+    }
+// notification statements
+}
