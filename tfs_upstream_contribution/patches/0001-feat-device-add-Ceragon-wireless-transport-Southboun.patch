+// meta
+    organization
+      "Siklu";
+
+    contact
+      "Support: <https://siklu.com/contact/>";
+
+    description
+      "This YANG module is part of MultiHaul(tm) TG project.
+        It defines the username/password management of the project";
+
+    revision 2023-04-20 {
+        description
+          "Change yang version to 1.1";
+        reference
+          "";
+    }
+
+    revision 2023-02-26 {
+        description
+          "Set length limitation for user name";
+        reference
+          "";
+    }
+
+    revision 2022-02-14 {
+        description
+          "drop clixon-lib";
+        reference
+          "clixon CHANGELOG.md";
+    }
+
+    revision 2022-02-07 {
+        description
+          "import clixon-autocli";
+        reference
+          "clixon CHANGELOG.md";
+    }
+
+    revision 2021-05-25 {
+        description
+          "Release";
+        reference
+          "";
+    }
+
+    revision 2020-11-01 {
+        description
+          "Initial revision";
+        reference
+          "TBD";
+    }
+
+// extension statements
+// feature statements
+// identity statements
+// typedef statements
+// grouping statements
+    grouping user-management-top {
+        description
+          "Top level grouping for user management";
+        container user-management {
+            description
+              "Top level container for user management";
+            list user {
+                key "username";
+                description
+                  "username";
+                leaf username {
+                    type string{
+                      length "1..32";
+                      pattern '[A-Za-z0-9.\-_]+';
+                    }
+                    description
+                      "username - The characters that are allowed for username are 
+                       uppercase and lowercase letters, digits 
+                       and the following three characters _-.";
+                }
+
+                leaf password {
+                    autocli:hide;
+                    autocli:hide-show;
+                    type string{
+                        length "63";
+                        pattern
+                          '$5$[A-Za-z0-9/.]+$[A-Za-z0-9/.]+';
+                    }
+                    description
