+
+    grouping topo-scan-result-group {
+        leaf remote-assigned-name {
+            type rb-tg-types:node-assigned-name;
+            description
+              "Assigned name of remote node found by scan";
+        }
+        leaf remote-sector {
+            type rb-tg-types:radio-sector-index;
+            description
