# CER-Intent Configuration
# Copy this file to .env and fill in your values

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set GEMINI_API_KEY to enable NLP-based intent parsing via Google Gemini.
# If not set, the system falls back to keyword-based rule parser automatically.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for intent parsing (gemini-1.5-flash is fast and cheap)
GEMINI_MODEL=gemini-1.5-flash

# ── Server ────────────────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# ── Assurance ─────────────────────────────────────────────────────────────────
# How often (seconds) the reconciler checks intent fulfillment
RECONCILE_INTERVAL_SECONDS=10

# How often (seconds) telemetry simulator pushes state updates
TELEMETRY_INTERVAL_SECONDS=5

# ── Data Paths ────────────────────────────────────────────────────────────────
STATE_FILE=data/topology_state.json
AUDIT_LOG_FILE=data/audit_log.jsonl
