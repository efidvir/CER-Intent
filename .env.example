# CER-Intent Configuration
# Copy this file to .env and fill in your site-specific values.
# All variables are optional and fall back to portable defaults.

# ── Device & SDN Adapter Backend ──────────────────────────────────────────────
# Options: option_a | siklu_tg | teraflow | simulated
ADAPTER_BACKEND=option_a

# ── TeraFlowSDN (Network Source of Truth & E-Band Control) ────────────────────
TERAFLOW_URL=http://127.0.0.1:8088
TFS_URL=http://127.0.0.1:8088
TFS_CONTEXT=admin
TFS_TOPOLOGY=admin
TERAFLOW_TIMEOUT_SEC=10

# ── Physical Transceiver & Siklu V-Band Terragraph (TG) Adapter ───────────────
# Set TG_CONTROLLER_URL to enable live RESTCONF/SNMP actuation on Siklu TG nodes.
# Leave empty to run in hardware-calibrated emulation mode.
TG_CONTROLLER_URL=
TG_USERNAME=admin
TG_PASSWORD=admin
TG_VERIFY_SSL=false

# Primary device parameters for single-link digital twin tests
CERAGON_IP=192.168.1.225
CERAGON_UUID=f676623c-1a65-54bd-b1e8-279c8a6d8a1c
CERAGON_NAME=Ceragon MH-T261 (ctu-96)

# ── Multi-Hop Testbed Topology (Option A or Custom Site Topology) ─────────────
# Path to the JSON topology file defining nodes, links, candidate bridges, and flows
TESTBED_TOPOLOGY_FILE=data/option_a_topology.json

# ── D2.4 External Conflict Resolution Fabric ──────────────────────────────────
# Mode: auto_approve (default stub returning APPROVED) | external (HTTP POST)
CONFLICT_FABRIC_MODE=auto_approve
CONFLICT_FABRIC_URL=http://127.0.0.1:6000/api/v1/conflict-fabric/evaluate

# ── NS-3 Discrete-Event Simulation Core ───────────────────────────────────────
# Set USE_REMOTE_NS3=true to execute NS-3 over SSH on NS3_HOST; false for local emulator
USE_REMOTE_NS3=false
NS3_USER=efid
NS3_HOST=localhost
NS3_DIR=/home/efid/ns3-dev

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set GEMINI_API_KEY to enable NLP-based intent parsing via Google Gemini.
# If not set, the system falls back to the deterministic rule parser automatically.
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Server ────────────────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# ── Assurance ─────────────────────────────────────────────────────────────────
RECONCILE_INTERVAL_SECONDS=10
TELEMETRY_INTERVAL_SECONDS=5

# ── Data Paths ────────────────────────────────────────────────────────────────
STATE_FILE=data/topology_state.json
AUDIT_LOG_FILE=data/audit_log.jsonl
