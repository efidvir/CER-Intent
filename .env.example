# CER-Intent Configuration
# Copy this file to .env and fill in your site-specific values.
# All variables are optional and fall back to portable defaults.

# ── Device & SDN Adapter Backend ──────────────────────────────────────────────
# Options: option_a | siklu_tg | teraflow | simulated
ADAPTER_BACKEND=option_a

# ── TeraFlowSDN (Network Source of Truth & E-Band Control) ────────────────────
TERAFLOW_URL=http://127.0.0.1:8088
TFS_URL=http://127.0.0.1:8088
TFS_CONTEXT=admin
TFS_TOPOLOGY=admin
TERAFLOW_TIMEOUT_SEC=10

# ── Physical Transceiver & Siklu V-Band Terragraph (TG) Adapter ───────────────
# Set TG_CONTROLLER_URL to enable live RESTCONF/SNMP actuation on Siklu TG nodes.
# Leave empty to run in hardware-calibrated emulation mode.
TG_CONTROLLER_URL=
TG_USERNAME=admin
TG_PASSWORD=admin
TG_VERIFY_SSL=false

# Primary device parameters for single-link digital twin tests
CERAGON_IP=192.168.1.225
CERAGON_UUID=f676623c-1a65-54bd-b1e8-279c8a6d8a1c
CERAGON_NAME=Ceragon MH-T261 (ctu-96)

# ── Multi-Hop Testbed Topology (Option A or Custom Site Topology) ─────────────
# Path to the JSON topology file defining nodes, links, candidate bridges, and flows
TESTBED_TOPOLOGY_FILE=data/option_a_topology.json

# ── D2.4 External Conflict Resolution Fabric ──────────────────────────────────
# Mode: auto_approve (default stub returning APPROVED) | external (HTTP POST)
CONFLICT_FABRIC_MODE=auto_approve
CONFLICT_FABRIC_URL=http://127.0.0.1:6000/api/v1/conflict-fabric/evaluate

# ── NS-3 Discrete-Event Simulation Core ───────────────────────────────────────
# Set USE_REMOTE_NS3=true to execute NS-3 over SSH on NS3_HOST; false for local emulator
USE_REMOTE_NS3=false
NS3_USER=efid
NS3_HOST=localhost
NS3_DIR=/home/efid/ns3-dev

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set GEMINI_API_KEY to enable NLP-based intent parsing via Google Gemini.
# If not set, the system falls back to the deterministic rule parser automatically.
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Server ────────────────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# ── Assurance ─────────────────────────────────────────────────────────────────
RECONCILE_INTERVAL_SECONDS=10
TELEMETRY_INTERVAL_SECONDS=5

# ── Data Paths ────────────────────────────────────────────────────────────────
STATE_FILE=data/topology_state.json
AUDIT_LOG_FILE=data/audit_log.jsonl

# ── Slice controller ──────────────────────────────────────────────────────────
# TFS_REALIZATION=ietf            # ietf | nsc | tfs-api | dry-run
# CER_INTENT_TOPOLOGY_FILE=emulation/containerlab/tfs-topology.json   # planner topology without TeraFlowSDN
# TWIN_URL=http://localhost:9100  # digital twin for what-if

# ── Intent manager (studio, /api/v2, TMF921, 3GPP TS 28.312) ──────────────────
# CER_IMF_AUTO=0                   # 1: auto-approval on with the policy's guardrails (data/imf_policy.json)
# CER_IMF_POLICY=data/imf_policy.json
# CER_IMF_ALIASES=data/imf_aliases.json
# CER_SITE_PLAN=emulation/flow/site_plan.json   # hop distances and design rain (shared with the twin)
# CER_IMF_TWIN=1                   # 0: check with the analytic radio screen only
# CER_IMF_DISCOVERY=1              # 0: do not read device details and live radio state through TeraFlowSDN
# CER_IMF_DISCOVERY_TTL_S=15       # how long device details are reused
# CER_IMF_TICK_S=10                # how often schedules, objectives and auto-approval watches are checked
# CER_IMF_LLM=none                 # none | gemini | anthropic | openai: a model's reading next to the rules'

# ── Who acts ──────────────────────────────────────────────────────────────────
# CER_AUTH=headers                 # headers: X-User / X-Role as sent | token: tokens file, /login, cookie
# CER_AUTH_TOKENS_FILE=deploy/config/tokens.yaml
# CER_AUTH_OPEN_READ=1             # 0: reading also needs a token
# CER_SECRET_KEY=                  # signs the session cookie (random per start when empty)
# CER_COOKIE_SECURE=0              # 1 when served over HTTPS
# CER_INTENT_TOKEN=                # the MCP tools' token, when CER-Intent asks for one

# ── Containers (compose.yaml) ─────────────────────────────────────────────────
# Inside a container 127.0.0.1 is the container itself: give TERAFLOW_URL as the containers reach
# TeraFlowSDN (its host's address, or host.docker.internal on Docker Desktop).
# CER_READY_REQUIRE=               # teraflow,twin: /readyz fails while they are down
# CER_INTENT_PORT=5000
